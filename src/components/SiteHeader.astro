---
import { sitePath, withBase } from "../lib/paths";

const path = sitePath(Astro.url.pathname);

const links = [
  { href: withBase("/"), label: "Home", current: path === "/" },
  { href: withBase("/about/"), label: "About", current: path.startsWith("/about") },
  { href: withBase("/work/"), label: "Work", current: path.startsWith("/work") },
  { href: withBase("/contact/"), label: "Contact", current: path.startsWith("/contact") },
];
---

<header class="site-nav" id="top">
  <a class="brand" href={withBase("/")}>Think. Create. Transform.</a>
  <nav class="navlinks" aria-label="Main">
    {
      links.map((link) => (
        <a
          href={link.href}
          class:list={{ active: link.current }}
          aria-current={link.current ? "page" : undefined}
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</header>
