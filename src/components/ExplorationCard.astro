---
import type { ImageMetadata } from "astro";
import FrameImage from "./FrameImage.astro";

interface Props {
  href: string;
  caption: string;
  image: ImageMetadata;
  imageAlt: string;
}
const { href, caption, image, imageAlt } = Astro.props;
---

<a class="explore-card" href={href}>
  <figure>
    <div class="ui-aspect" style="--ratio: 16/11">
      <FrameImage
        src={image}
        alt={imageAlt}
        widths={[480, 768, 1100]}
        sizes="(max-width: 640px) calc(100vw - 40px), 680px"
      />
    </div>
    <figcaption>{caption}</figcaption>
  </figure>
</a>
