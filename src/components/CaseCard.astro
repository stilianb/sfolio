---
import type { ImageMetadata } from "astro";
import FrameImage from "./FrameImage.astro";

interface Props {
  href: string;
  title: string;
  summary: string;
  image: ImageMetadata;
  imageAlt: string;
  eager?: boolean;
}
const { href, title, summary, image, imageAlt, eager = false } = Astro.props;
---

<div class="case">
  <a class="case-art" href={href} aria-label={`${title} case study`}>
    <div class="ui-aspect natural">
      <FrameImage
        src={image}
        alt={imageAlt}
        widths={[480, 768, 960]}
        sizes="(max-width: 640px) calc(100vw - 40px), (max-width: 980px) 46vw, 420px"
        loading={eager ? "eager" : "lazy"}
        fetchpriority={eager ? "high" : undefined}
      />
    </div>
  </a>
  <div class="case-body">
    <h3>{title}</h3>
    <p>{summary}</p>
  </div>
</div>
