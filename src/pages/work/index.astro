---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CaseCard from "../../components/CaseCard.astro";
import ExplorationCard from "../../components/ExplorationCard.astro";
import { imageAlt } from "../../lib/image-alts";
import { withBase } from "../../lib/paths";
import { caseStudies, explorations, getWork } from "../../lib/work";

const all = await getWork();
const studies = caseStudies(all);
const explore = explorations(all);
const description = "A collection of case studies, projects and explorations.";
---

<BaseLayout
  title="Work — Scully Balasopoulov"
  description={description}
  image={studies[0]?.data.cover}
>
  <section class="org-page-head">
    <div class="org-wrap">
      <h1>A collection of case studies, projects and explorations</h1>
    </div>
  </section>

  <section class="org-section org-work-cases">
    <div class="org-wrap">
      <div class="org-head"><h2>Case Studies</h2></div>
      <div class="org-work-grid">
        {
          studies.map((entry) => (
            <CaseCard
              href={withBase(`/work/${entry.data.slug}/`)}
              title={entry.data.title}
              summary={entry.data.summary}
              image={entry.data.thumbnail}
              imageAlt={imageAlt[`${entry.data.slug}-thumb` as keyof typeof imageAlt]}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="org-section">
    <div class="org-wrap">
      <div class="org-head"><h2>Explorations</h2></div>
      <div class="org-explore-grid">
        {
          explore.map((entry) => (
            <ExplorationCard
              href={withBase(`/work/${entry.data.slug}/`)}
              caption={entry.data.summary}
              image={entry.data.thumbnail}
              imageAlt={imageAlt[`${entry.data.slug}-thumb` as keyof typeof imageAlt]}
            />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
